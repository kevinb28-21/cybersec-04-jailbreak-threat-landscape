# ============================================================
# Jailbreak-as-a-Service Threat Landscape — Example Config
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.0

# ── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_MAX_TOKENS=1024

# ── Test runner settings ─────────────────────────────────────
# Number of times each technique is retried on API errors
RETRY_ATTEMPTS=3
# Seconds between requests (rate limiting)
REQUEST_DELAY=1.5
# Max concurrent requests (0 = sequential)
MAX_CONCURRENT=0
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Output settings ──────────────────────────────────────────
# Directory for run results (relative to project root)
OUTPUT_DIR=results
# Append a timestamp to each results file name (true/false)
TIMESTAMP_RESULTS=true

# ── Taxonomy settings ────────────────────────────────────────
TAXONOMY_FILE=techniques/jailbreak_techniques.json
MITRE_ATLAS_VERSION=2.1.0

# ── Safety / ethics gate ─────────────────────────────────────
# Set to "true" to run in DRY_RUN mode (no actual API calls,
# uses synthetic responses for pipeline validation only).
DRY_RUN=false
# Extra content-safety check before sending each prompt
ENABLE_PREFLIGHT_SAFETY_CHECK=true
