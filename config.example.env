# ============================================================
# Aegis Sentinel — Platform Configuration
# Copy to .env and customize. NEVER commit .env to version control.
# ============================================================

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
DEPLOYMENT_PROFILE=personal
LOG_LEVEL=INFO

# ── API Security (REQUIRED in production) ─────────────────────
API_KEY=dev-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8080
RATE_LIMIT_PER_MINUTE=120
MAX_PROMPT_LENGTH=32000
MAX_LOG_LINE_LENGTH=16000

# ── Event Bus ─────────────────────────────────────────────────
EVENT_BUS_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── Detection & Response ────────────────────────────────────────
DETECTION_TIER_MAX=3
ML_ENABLED=true
CORRELATION_WINDOW_SECONDS=300
AUTO_RESPONSE_ENABLED=false
AUTO_RESPONSE_TIER=2
SOAR_COOLDOWN_SECONDS=60
ALERT_DEDUP_WINDOW_SECONDS=30
SOAR_SIMULATION_MODE=true

# ── Storage ───────────────────────────────────────────────────
DATA_DIR=data
SQLITE_PATH=data/aegis.db

# ── Watchdog ──────────────────────────────────────────────────
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SECONDS=30

# ── Legacy Project 04 (optional red-team testing) ─────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DRY_RUN=true
